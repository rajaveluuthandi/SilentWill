# Copy to .env.local, then fill in:   cp .env.example .env.local
#
# Get the values from: Supabase Dashboard -> Project Settings -> API
#   NEXT_PUBLIC_SUPABASE_URL       = Project URL
#   NEXT_PUBLIC_SUPABASE_ANON_KEY  = anon public key
#
# Next.js loads env files ONLY from this directory (apps/web/). Files at the
# monorepo root are NOT read by the web app.
#
# Both values must be SINGLE-LINE and UNQUOTED. A line-wrapped JWT makes every
# Supabase call fail with 401 "Invalid API key" -- do not run `vercel env pull`
# into .env.local, because it wraps the ~208-char anon key across lines with a
# literal backslash-n that dotenv then expands into real newlines.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
