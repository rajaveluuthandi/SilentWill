{
  "expo": {
    "name": "SilentWill",
    "slug": "silentwill",
    "version": "1.0.0",
    "scheme": "silentwill",
    "platforms": [
      "ios",
      "android"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.silentwill.app",
      "infoPlist": {
        "NSCameraUsageDescription": "SilentWill uses the camera to place a 3D view of your assets in the room around you. No photos or video are recorded or uploaded."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#4F46E5"
      },
      "package": "com.silentwill.app"
    },
    "experiments": {
      "typedRoutes": true
    },
    "plugins": [
      "expo-font",
      "expo-sqlite",
      "./plugins/withFmtCxx17",
      "./plugins/withDevelopmentTeam"
    ]
  }
}
