# REFERENCE SHEET ONLY — no app loads env from the monorepo root.
#
#   apps/web     reads  apps/web/.env.local     (NEXT_PUBLIC_*)  <- apps/web/.env.example
#   apps/mobile  reads  apps/mobile/.env        (EXPO_PUBLIC_*)
#
# Copying this file to a root `.env` will NOT configure either app. Put the
# values in the per-app file listed above.
#
# Get these from: Supabase Dashboard → Project Settings → API
# Values must be single-line and unquoted.

# Used by Next.js (apps/web) — belongs in apps/web/.env.local
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Used by Expo (apps/mobile) — belongs in apps/mobile/.env
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
